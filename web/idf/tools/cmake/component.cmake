# The ESP-IDF build functions a component uses, and the steps of project() (project.cmake), for the
# CardenzaHAL web target.

# ESP-IDF's own components: every component already has their headers (the web target's runtime), so
# a requirement on one links nothing. A name not here and not in the project is taken as one of these
# too: if its headers are missing, the compiler says which.
set(CARDENZA_WEB_IDF_COMPONENTS
    app_trace app_update bootloader_support bt cxx driver efuse esp_adc esp_app_format esp_bootloader_format
    esp_coex esp_common esp_driver_ana_cmpr esp_driver_cam esp_driver_dac esp_driver_gpio esp_driver_gptimer
    esp_driver_i2c esp_driver_i2s esp_driver_isp esp_driver_jpeg esp_driver_ledc esp_driver_mcpwm esp_driver_parlio
    esp_driver_pcnt esp_driver_ppa esp_driver_rmt esp_driver_sdio esp_driver_sdm esp_driver_sdmmc esp_driver_sdspi
    esp_driver_spi esp_driver_touch_sens esp_driver_tsens esp_driver_uart esp_driver_usb_serial_jtag esp_eth
    esp_event esp_gdbstub esp_hid esp_http_client esp_http_server esp_https_ota esp_https_server esp_hw_support
    esp_lcd esp_local_ctrl esp_mm esp_netif esp_netif_stack esp_partition esp_phy esp_pm esp_psram esp_ringbuf
    esp_rom esp_system esp_timer esp_vfs_console esp_wifi espcoredump esptool_py fatfs freertos hal heap
    http_parser idf_test ieee802154 json log lwip mbedtls mqtt newlib nvs_flash nvs_sec_provider openthread
    partition_table perfmon protobuf-c protocomm pthread riscv sdmmc soc spi_flash spiffs tcp_transport ulp
    unity usb vfs wear_levelling wifi_provisioning wpa_supplicant xtensa)

# Flags for the chip's compiler that mean nothing (or something else) to Emscripten's: dropped from
# every component's options.
set(CARDENZA_WEB_DEVICE_FLAGS
    -mlongcalls -mtext-section-literals -mdisable-hardware-atomics -mfix-esp32-psram-cache-issue
    -mfix-esp32-psram-cache-strategy=[a-z]+ -fstrict-volatile-bitfields -fno-tree-switch-conversion
    -fsingle-precision-constant -fno-shrink-wrap -freorder-blocks-algorithm=[a-z]+ -Wno-frame-address
    -fno-builtin-memcpy -fno-builtin-memset -nostartfiles -Wl,--gc-sections -Wl,--cref -Wl,--Map=[^ ;]+)

# ---- build properties ---------------------------------------------------------------------------------

function(idf_build_set_property property value)
    cmake_parse_arguments(_ "APPEND" "" "" ${ARGN})
    if(__APPEND)
        set_property(GLOBAL APPEND PROPERTY CARDENZA_WEB_BUILD_${property} "${value}")
    else()
        set_property(GLOBAL PROPERTY CARDENZA_WEB_BUILD_${property} "${value}")
    endif()
endfunction()

function(idf_build_get_property out property)
    cmake_parse_arguments(_ "GENERATOR_EXPRESSION" "" "" ${ARGN})
    if(property STREQUAL "IDF_TARGET")
        set(value esp32s3)
    elseif(property STREQUAL "IDF_PATH")
        set(value "${CARDENZA_WEB_IDF_PATH}")
    elseif(property STREQUAL "IDF_VER")
        set(value "v5.3.5-cardenza-web")
    elseif(property STREQUAL "BUILD_COMPONENTS" OR property STREQUAL "__BUILD_COMPONENTS")
        get_property(names GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_NAMES)
        set(value ${names} ${CARDENZA_WEB_IDF_COMPONENTS})
    elseif(property STREQUAL "IDF_TARGET_ARCH")
        set(value xtensa)
    elseif(property STREQUAL "SDKCONFIG")
        set(value "${CMAKE_SOURCE_DIR}/sdkconfig")
    else()
        get_property(value GLOBAL PROPERTY CARDENZA_WEB_BUILD_${property})
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# ESP-IDF: the value of one CONFIG_ option.
function(idf_build_get_config out config)
    set(${out} "${${config}}" PARENT_SCOPE)
endfunction()

function(idf_component_get_property out component property)
    if(property STREQUAL "COMPONENT_LIB" OR property STREQUAL "COMPONENT_TARGET")
        __cardenza_web_component_lib(lib "${component}")
        set(${out} "${lib}" PARENT_SCOPE)
        return()
    endif()
    get_property(value GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${component}_${property})
    if(property STREQUAL "COMPONENT_NAME" AND NOT value)
        set(value "${component}")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(idf_component_set_property component property value)
    cmake_parse_arguments(_ "APPEND" "" "" ${ARGN})
    if(__APPEND)
        set_property(GLOBAL APPEND PROPERTY CARDENZA_WEB_COMPONENT_${component}_${property} "${value}")
    else()
        set_property(GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${component}_${property} "${value}")
    endif()
endfunction()

# The library of a component: the project's own, or for one of ESP-IDF's an empty library with the
# runtime's headers, so a firmware may set options on it as it would on the device.
function(__cardenza_web_component_lib out component)
    get_property(lib GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${component}_COMPONENT_LIB)
    if(NOT lib)
        set(lib "__idf_${component}")
        if(NOT TARGET ${lib})
            set(source "${CMAKE_BINARY_DIR}/esp-idf/${component}/cardenza_web_empty.c")
            file(WRITE "${source}" "/* ${component}: ESP-IDF's, provided by the CardenzaHAL web target's runtime. */\n")
            add_library(${lib} STATIC "${source}")
            target_link_libraries(${lib} PUBLIC cardenza_web_idf)
        endif()
    endif()
    set(${out} "${lib}" PARENT_SCOPE)
endfunction()

# ---- idf_component_register -----------------------------------------------------------------------------

function(idf_component_register)
    cmake_parse_arguments(_ "WHOLE_ARCHIVE" "KCONFIG;KCONFIG_PROJBUILD"
        "SRCS;SRC_DIRS;EXCLUDE_SRCS;INCLUDE_DIRS;PRIV_INCLUDE_DIRS;LDFRAGMENTS;REQUIRES;PRIV_REQUIRES;REQUIRED_IDF_TARGETS;EMBED_FILES;EMBED_TXTFILES"
        ${ARGN})
    if(DEFINED COMPONENT_NAME)
        set(name "${COMPONENT_NAME}")
    else()
        get_filename_component(name "${CMAKE_CURRENT_SOURCE_DIR}" NAME)
    endif()
    set(dir "${CMAKE_CURRENT_SOURCE_DIR}")
    if(__REQUIRED_IDF_TARGETS AND NOT "esp32s3" IN_LIST __REQUIRED_IDF_TARGETS)
        message(FATAL_ERROR "cardenza-web: component ${name} is only for ${__REQUIRED_IDF_TARGETS}")
    endif()

    set(sources)
    foreach(source IN LISTS __SRCS)
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${dir}")
        list(APPEND sources "${source}")
    endforeach()
    foreach(source_dir IN LISTS __SRC_DIRS)
        get_filename_component(source_dir "${source_dir}" ABSOLUTE BASE_DIR "${dir}")
        file(GLOB found "${source_dir}/*.c" "${source_dir}/*.cpp" "${source_dir}/*.cc" "${source_dir}/*.cxx" "${source_dir}/*.S" "${source_dir}/*.s")
        list(SORT found)
        list(APPEND sources ${found})
    endforeach()
    foreach(excluded IN LISTS __EXCLUDE_SRCS)
        get_filename_component(excluded "${excluded}" ABSOLUTE BASE_DIR "${dir}")
        list(REMOVE_ITEM sources "${excluded}")
    endforeach()
    # Xtensa assembly cannot run in a browser.
    set(compiled)
    foreach(source IN LISTS sources)
        if(source MATCHES "\\.[sS]$")
            message(SEND_ERROR "cardenza-web: unsupported-source: ${source} (assembly for the chip)")
        else()
            list(APPEND compiled "${source}")
        endif()
    endforeach()

    set(lib "__idf_${name}")
    if(compiled OR __EMBED_FILES OR __EMBED_TXTFILES)
        add_library(${lib} STATIC ${compiled})
        set(scope PUBLIC)
        set(private PRIVATE)
    else()
        add_library(${lib} INTERFACE)
        set(scope INTERFACE)
        set(private INTERFACE)
    endif()
    add_library(idf::${name} ALIAS ${lib})
    foreach(include IN LISTS __INCLUDE_DIRS)
        get_filename_component(include "${include}" ABSOLUTE BASE_DIR "${dir}")
        target_include_directories(${lib} ${scope} "${include}")
    endforeach()
    foreach(include IN LISTS __PRIV_INCLUDE_DIRS)
        get_filename_component(include "${include}" ABSOLUTE BASE_DIR "${dir}")
        target_include_directories(${lib} ${private} "${include}")
    endforeach()
    target_link_libraries(${lib} ${scope} cardenza_web_idf)
    foreach(file IN LISTS __EMBED_FILES)
        target_add_binary_data(${lib} "${file}" BINARY)
    endforeach()
    foreach(file IN LISTS __EMBED_TXTFILES)
        target_add_binary_data(${lib} "${file}" TEXT)
    endforeach()

    idf_component_set_property(${name} COMPONENT_LIB "${lib}")
    idf_component_set_property(${name} COMPONENT_NAME "${name}")
    idf_component_set_property(${name} COMPONENT_DIR "${dir}")
    idf_component_set_property(${name} REQUIRES "${__REQUIRES}")
    idf_component_set_property(${name} PRIV_REQUIRES "${__PRIV_REQUIRES}")
    idf_component_set_property(${name} WHOLE_ARCHIVE "${__WHOLE_ARCHIVE}")
    idf_component_set_property(${name} SRCS "${compiled}")
    set_property(GLOBAL APPEND PROPERTY CARDENZA_WEB_REGISTERED "${name}")
    set(COMPONENT_LIB "${lib}" PARENT_SCOPE)
    set(COMPONENT_TARGET "${lib}" PARENT_SCOPE)
    set(COMPONENT_ALIAS "idf::${name}" PARENT_SCOPE)
endfunction()

# The old registration (ESP-IDF 3): COMPONENT_SRCS, COMPONENT_ADD_INCLUDEDIRS, COMPONENT_REQUIRES.
macro(register_component)
    idf_component_register(SRCS ${COMPONENT_SRCS} SRC_DIRS ${COMPONENT_SRCDIRS} INCLUDE_DIRS ${COMPONENT_ADD_INCLUDEDIRS}
                           PRIV_INCLUDE_DIRS ${COMPONENT_PRIV_INCLUDEDIRS} REQUIRES ${COMPONENT_REQUIRES}
                           PRIV_REQUIRES ${COMPONENT_PRIV_REQUIRES} EMBED_FILES ${COMPONENT_EMBED_FILES}
                           EMBED_TXTFILES ${COMPONENT_EMBED_TXTFILES})
endmacro()

macro(register_config_only_component)
    idf_component_register()
endmacro()

# A file as data in the firmware, with ESP-IDF's symbols: <name>, _binary_<name>_start, _binary_<name>_end
# and <name>_length (a TEXT file gets a terminating zero, not counted in the length).
function(target_add_binary_data target embed_file embed_type)
    cmake_parse_arguments(_ "" "RENAME_TO" "DEPENDS" ${ARGN})
    get_filename_component(embed_file "${embed_file}" ABSOLUTE)
    get_filename_component(file_name "${embed_file}" NAME)
    if(__RENAME_TO)
        set(file_name "${__RENAME_TO}")
    endif()
    string(MAKE_C_IDENTIFIER "${file_name}" symbol)
    set(source "${CMAKE_BINARY_DIR}/embedded/${symbol}.c")
    add_custom_command(OUTPUT "${source}"
        COMMAND "${CMAKE_COMMAND}" -D "DATA_FILE=${embed_file}" -D "SOURCE_FILE=${source}" -D "SYMBOL=${symbol}" -D "FILE_TYPE=${embed_type}"
                -P "${CARDENZA_WEB_IDF_PATH}/tools/cmake/embed_data.cmake"
        MAIN_DEPENDENCY "${embed_file}"
        DEPENDS "${CARDENZA_WEB_IDF_PATH}/tools/cmake/embed_data.cmake" ${__DEPENDS}
        VERBATIM)
    target_sources(${target} PRIVATE "${source}")
endfunction()

