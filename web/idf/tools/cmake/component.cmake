# ---- project() steps ------------------------------------------------------------------------------------

function(__cardenza_web_project_version out)
    if(DEFINED ${out} AND NOT "${${out}}" STREQUAL "")
        return()
    endif()
    set(version "")
    if(EXISTS "${CMAKE_SOURCE_DIR}/version.txt")
        file(STRINGS "${CMAKE_SOURCE_DIR}/version.txt" version LIMIT_COUNT 1)
        string(STRIP "${version}" version)
    endif()
    if(version STREQUAL "")
        execute_process(COMMAND git -C "${CMAKE_SOURCE_DIR}" describe --always --tags --dirty
                        OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
        if(failed)
            set(version "")
        endif()
    endif()
    if(version STREQUAL "")
        set(version "1")
    endif()
    set(${out} "${version}" PARENT_SCOPE)
endfunction()

# sdkconfig.h and sdkconfig.cmake in <build>/config: the project's sdkconfig when it has one, else its
# defaults over ESP-IDF's (tools/cardenza_web.py sdkconfig).
macro(__cardenza_web_sdkconfig)
    set(cardenza_web_config_dir "${CMAKE_BINARY_DIR}/config")
    if(NOT DEFINED SDKCONFIG)
        set(SDKCONFIG "${CMAKE_SOURCE_DIR}/sdkconfig")
    endif()
    if(NOT DEFINED SDKCONFIG_DEFAULTS)
        if(DEFINED ENV{SDKCONFIG_DEFAULTS})
            set(SDKCONFIG_DEFAULTS "$ENV{SDKCONFIG_DEFAULTS}")
        elseif(EXISTS "${CMAKE_SOURCE_DIR}/sdkconfig.defaults")
            set(SDKCONFIG_DEFAULTS "${CMAKE_SOURCE_DIR}/sdkconfig.defaults")
        endif()
    endif()
    set(cardenza_web_defaults)
    foreach(defaults IN LISTS SDKCONFIG_DEFAULTS)
        get_filename_component(defaults "${defaults}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
        list(APPEND cardenza_web_defaults "${defaults}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${defaults}")
        if(EXISTS "${defaults}.esp32s3")
            list(APPEND cardenza_web_defaults "${defaults}.esp32s3")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${defaults}.esp32s3")
        endif()
    endforeach()
    set(cardenza_web_sdkconfig_args --out "${cardenza_web_config_dir}")
    if(EXISTS "${SDKCONFIG}")
        list(APPEND cardenza_web_sdkconfig_args --sdkconfig "${SDKCONFIG}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SDKCONFIG}")
    endif()
    foreach(defaults IN LISTS cardenza_web_defaults)
        list(APPEND cardenza_web_sdkconfig_args --defaults "${defaults}")
    endforeach()
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${CARDENZA_WEB_HAL_DIR}/tools/cardenza_web.py" sdkconfig ${cardenza_web_sdkconfig_args}
                    RESULT_VARIABLE cardenza_web_failed)
    if(cardenza_web_failed)
        message(FATAL_ERROR "cardenza-web: sdkconfig.h could not be made")
    endif()
    include("${cardenza_web_config_dir}/sdkconfig.cmake")
    idf_build_set_property(SDKCONFIG_HEADER "${cardenza_web_config_dir}/sdkconfig.h")
    idf_build_set_property(SDKCONFIG_CMAKE "${cardenza_web_config_dir}/sdkconfig.cmake")
endmacro()

# What every component gets: the runtime's ESP-IDF headers, sdkconfig.h, and ESP-IDF's definitions.
function(__cardenza_web_make_idf_interface)
    add_library(cardenza_web_idf INTERFACE)
    target_include_directories(cardenza_web_idf INTERFACE "${CMAKE_BINARY_DIR}/config" "${CARDENZA_WEB_DIR}/include")
    target_compile_definitions(cardenza_web_idf INTERFACE ESP_PLATFORM=1 "IDF_VER=\"v5.3.5-cardenza-web\"" CARDENZA_HAL_WEB=1)
    if(NOT CONFIG_COMPILER_CXX_RTTI)
        target_compile_options(cardenza_web_idf INTERFACE $<$<COMPILE_LANGUAGE:CXX>:-fno-rtti>)
    endif()
    if(NOT CONFIG_COMPILER_CXX_EXCEPTIONS)
        target_compile_options(cardenza_web_idf INTERFACE $<$<COMPILE_LANGUAGE:CXX>:-fno-exceptions>)
    endif()
    # Options the chip's compiler takes and clang warns about rather than the firmware's code.
    target_compile_options(cardenza_web_idf INTERFACE -Wno-unknown-warning-option -Wno-unused-command-line-argument)
endfunction()

# The HAL's version and commit, and a hash that names this build (esp_app_get_elf_sha256).
function(__cardenza_web_identity name version)
    set(hal_version "")
    if(EXISTS "${CARDENZA_WEB_HAL_DIR}/version.txt")
        file(STRINGS "${CARDENZA_WEB_HAL_DIR}/version.txt" hal_version LIMIT_COUNT 1)
        string(STRIP "${hal_version}" hal_version)
    endif()
    execute_process(COMMAND git -C "${CARDENZA_WEB_HAL_DIR}" rev-parse --short=8 HEAD
                    OUTPUT_VARIABLE hal_commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
    if(failed OR hal_commit STREQUAL "")
        set(hal_commit unknown)
    endif()
    execute_process(COMMAND git -C "${CMAKE_SOURCE_DIR}" rev-parse HEAD
                    OUTPUT_VARIABLE project_commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(hal_version STREQUAL "")
        set(CARDENZA_WEB_HAL_VERSION "${hal_commit}" PARENT_SCOPE)
    else()
        set(CARDENZA_WEB_HAL_VERSION "${hal_version}+${hal_commit}" PARENT_SCOPE)
    endif()
    string(SHA256 hash "${name};${version};${project_commit};${hal_commit}")
    set(CARDENZA_WEB_BUILD_HASH "${hash}" PARENT_SCOPE)
endfunction()

# The components, as ESP-IDF finds them. Earlier ones win over later ones of the same name.
function(__cardenza_web_find_components)
    set(candidates)
    if(DEFINED COMPONENT_DIRS)
        set(search ${COMPONENT_DIRS})
    else()
        set(search "${CMAKE_SOURCE_DIR}/main" "${CMAKE_SOURCE_DIR}/components" ${EXTRA_COMPONENT_DIRS})
    endif()
    list(APPEND search "${CMAKE_SOURCE_DIR}/managed_components")
    foreach(entry IN LISTS search)
        get_filename_component(entry "${entry}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
        if(NOT IS_DIRECTORY "${entry}")
            continue()
        endif()
        if(EXISTS "${entry}/CMakeLists.txt")
            list(APPEND candidates "${entry}")
        else()
            file(GLOB children LIST_DIRECTORIES true "${entry}/*")
            list(SORT children)
            foreach(child IN LISTS children)
                if(IS_DIRECTORY "${child}" AND EXISTS "${child}/CMakeLists.txt")
                    list(APPEND candidates "${child}")
                endif()
            endforeach()
        endif()
    endforeach()
    set(names)
    foreach(dir IN LISTS candidates)
        get_filename_component(name "${dir}" NAME)
        # TinyUSB is CardenzaHAL's business, and the web HAL has no USB stack.
        if(name MATCHES "^(espressif__)?(esp_)?tinyusb$" OR name IN_LIST EXCLUDE_COMPONENTS OR name IN_LIST names)
            continue()
        endif()
        list(APPEND names "${name}")
        set_property(GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${name}_COMPONENT_DIR "${dir}")
    endforeach()
    set_property(GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_NAMES "${names}")
endfunction()

# Each component's CMakeLists.txt, in its own build folder; CardenzaHAL becomes the web HAL.
function(__cardenza_web_add_components)
    get_property(names GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_NAMES)
    foreach(name IN LISTS names)
        get_property(dir GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${name}_COMPONENT_DIR)
        if(EXISTS "${dir}/cardenzaHAL.h")
            add_library(__idf_${name} INTERFACE)
            target_link_libraries(__idf_${name} INTERFACE cardenza_web_hal)
            add_library(idf::${name} ALIAS __idf_${name})
            idf_component_set_property(${name} COMPONENT_LIB "__idf_${name}")
            idf_component_set_property(${name} CARDENZA_HAL TRUE)
            set_property(GLOBAL APPEND PROPERTY CARDENZA_WEB_REGISTERED "${name}")
            set_property(GLOBAL PROPERTY CARDENZA_WEB_HAL_COMPONENT_DIR "${dir}")
            get_filename_component(here "${CARDENZA_WEB_HAL_DIR}" REALPATH)
            get_filename_component(there "${dir}" REALPATH)
            if(here STREQUAL there)
                message(STATUS "cardenza-web: ${name} is CardenzaHAL: the web HAL is built in its place")
            else()
                message(STATUS "cardenza-web: ${name} is CardenzaHAL (${dir}): the web HAL from ${CARDENZA_WEB_HAL_DIR} is built in its place")
            endif()
            # The HAL's CMakeLists.txt does not run here, so its check for 203cli runs here instead.
            include("${CARDENZA_WEB_HAL_DIR}/cmake/require_203cli.cmake")
            cardenza_hal_require_203cli()
            continue()
        endif()
        set(COMPONENT_NAME "${name}")
        set(COMPONENT_DIR "${dir}")
        set(COMPONENT_PATH "${dir}")
        add_subdirectory("${dir}" "${CMAKE_BINARY_DIR}/esp-idf/${name}")
    endforeach()
endfunction()

# REQUIRES and PRIV_REQUIRES, now that every component is known.
function(__cardenza_web_link_requirements)
    get_property(registered GLOBAL PROPERTY CARDENZA_WEB_REGISTERED)
    foreach(name IN LISTS registered)
        get_property(hal GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${name}_CARDENZA_HAL)
        if(hal)
            continue()
        endif()
        get_property(lib GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${name}_COMPONENT_LIB)
        get_property(requires GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${name}_REQUIRES)
        get_property(private GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${name}_PRIV_REQUIRES)
        get_target_property(type ${lib} TYPE)
        set(public_scope PUBLIC)
        set(private_scope PRIVATE)
        if(type STREQUAL "INTERFACE_LIBRARY")
            set(public_scope INTERFACE)
            set(private_scope INTERFACE)
        endif()
        # ESP-IDF: main without requirements requires every component.
        if(name STREQUAL "main" AND NOT requires AND NOT private)
            set(requires ${registered})
            list(REMOVE_ITEM requires main)
        endif()
        foreach(scope_list IN ITEMS requires private)
            if(scope_list STREQUAL "requires")
                set(scope ${public_scope})
            else()
                set(scope ${private_scope})
            endif()
            foreach(required IN LISTS ${scope_list})
                if(required STREQUAL name)
                    continue()
                endif()
                if(required IN_LIST registered)
                    get_property(required_lib GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${required}_COMPONENT_LIB)
                    target_link_libraries(${lib} ${scope} ${required_lib})
                elseif(NOT required IN_LIST CARDENZA_WEB_IDF_COMPONENTS)
                    message(STATUS "cardenza-web: ${name} requires ${required}, taken as one of ESP-IDF's components")
                endif()
            endforeach()
        endforeach()
    endforeach()
    # Options the firmware gave the whole build (idf_build_set_property(COMPILE_OPTIONS ...)).
    idf_build_get_property(options COMPILE_OPTIONS)
    idf_build_get_property(c_options C_COMPILE_OPTIONS)
    idf_build_get_property(cxx_options CXX_COMPILE_OPTIONS)
    idf_build_get_property(definitions COMPILE_DEFINITIONS)
    target_compile_options(cardenza_web_idf INTERFACE ${options})
    foreach(option IN LISTS c_options)
        target_compile_options(cardenza_web_idf INTERFACE $<$<COMPILE_LANGUAGE:C>:${option}>)
    endforeach()
    foreach(option IN LISTS cxx_options)
        target_compile_options(cardenza_web_idf INTERFACE $<$<COMPILE_LANGUAGE:CXX>:${option}>)
    endforeach()
    target_compile_definitions(cardenza_web_idf INTERFACE ${definitions})
endfunction()

function(__cardenza_web_scrub out)
    set(result)
    foreach(item IN LISTS ARGN)
        foreach(flag IN LISTS CARDENZA_WEB_DEVICE_FLAGS)
            string(REGEX REPLACE "(^|[ :>])${flag}($|[ >])" "\\1\\2" item "${item}")
        endforeach()
        string(STRIP "${item}" item)
        if(NOT item STREQUAL "" AND NOT item MATCHES "^\\$<[^:]*:>$")
            list(APPEND result "${item}")
        endif()
    endforeach()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

# The chip's compiler flags out of every component and its sources (CARDENZA_WEB_DEVICE_FLAGS).
function(__cardenza_web_scrub_device_flags)
    get_property(registered GLOBAL PROPERTY CARDENZA_WEB_REGISTERED)
    list(APPEND registered cardenza_web_idf)
    foreach(name IN LISTS registered)
        if(name STREQUAL "cardenza_web_idf")
            set(lib cardenza_web_idf)
        else()
            get_property(lib GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${name}_COMPONENT_LIB)
        endif()
        get_target_property(type ${lib} TYPE)
        set(properties INTERFACE_COMPILE_OPTIONS)
        if(NOT type STREQUAL "INTERFACE_LIBRARY")
            list(APPEND properties COMPILE_OPTIONS)
        endif()
        foreach(property IN LISTS properties)
            get_target_property(options ${lib} ${property})
            if(options)
                __cardenza_web_scrub(options ${options})
                set_target_properties(${lib} PROPERTIES ${property} "${options}")
            endif()
        endforeach()
        if(type STREQUAL "INTERFACE_LIBRARY")
            continue()
        endif()
        get_target_property(sources ${lib} SOURCES)
        get_target_property(source_dir ${lib} SOURCE_DIR)
        foreach(source IN LISTS sources)
            foreach(property IN ITEMS COMPILE_OPTIONS COMPILE_FLAGS)
                get_source_file_property(options "${source}" TARGET_DIRECTORY ${lib} ${property})
                if(options)
                    __cardenza_web_scrub(options ${options})
                    set_source_files_properties("${source}" TARGET_DIRECTORY ${lib} PROPERTIES ${property} "${options}")
                endif()
            endforeach()
        endforeach()
    endforeach()
endfunction()

# The firmware: every component, the web HAL and the runtime whole (nothing they register may be
# dropped), linked into <project>.js / <project>.wasm in the page's folder, which then gets the page.
function(__cardenza_web_executable name)
    set(source "${CMAKE_BINARY_DIR}/cardenza_web_app.c")
    file(WRITE "${source}" "/* ${name}: the firmware is in its components; app_main is called by the runtime's main task. */\n")
    add_executable(${name} "${source}")
    get_property(registered GLOBAL PROPERTY CARDENZA_WEB_REGISTERED)
    foreach(component IN LISTS registered)
        get_property(lib GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${component}_COMPONENT_LIB)
        get_property(whole GLOBAL PROPERTY CARDENZA_WEB_COMPONENT_${component}_WHOLE_ARCHIVE)
        if(whole)
            target_link_libraries(${name} PRIVATE "-Wl,--whole-archive" ${lib} "-Wl,--no-whole-archive")
        else()
            target_link_libraries(${name} PRIVATE ${lib})
        endif()
    endforeach()
    target_link_libraries(${name} PRIVATE "-Wl,--whole-archive" cardenza_web_hal cardenza_web_runtime "-Wl,--no-whole-archive")
    cardenza_web_link(${name} "${CARDENZA_WEB_SITE_DIR}")
    idf_build_set_property(EXECUTABLE "${name}")
    idf_build_set_property(EXECUTABLE_NAME "${name}")
    add_custom_command(TARGET ${name} POST_BUILD
        COMMAND "${Python3_EXECUTABLE}" "${CARDENZA_WEB_HAL_DIR}/tools/cardenza_web.py" assemble
                --project-json "${CMAKE_BINARY_DIR}/cardenza_web_project.json"
        VERBATIM)
endfunction()

function(__cardenza_web_json_string out value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

# What tools/cardenza_web.py needs to finish the page (assemble) and describe the build (sim.json).
function(__cardenza_web_write_project_json name version)
    get_property(hal_component GLOBAL PROPERTY CARDENZA_WEB_HAL_COMPONENT_DIR)
    get_property(names GLOBAL PROPERTY CARDENZA_WEB_REGISTERED)
    set(json "{}")
    foreach(pair IN ITEMS "name=${name}" "version=${version}" "hal_dir=${CARDENZA_WEB_HAL_DIR}" "hal_component_dir=${hal_component}"
                          "hal_version=${CARDENZA_WEB_HAL_VERSION}" "project_dir=${CMAKE_SOURCE_DIR}" "build_dir=${CMAKE_BINARY_DIR}"
                          "site_dir=${CARDENZA_WEB_SITE_DIR}" "build_type=${CMAKE_BUILD_TYPE}" "emscripten=${EMSCRIPTEN_VERSION}"
                          "module=${name}.js")
        string(FIND "${pair}" "=" at)
        string(SUBSTRING "${pair}" 0 ${at} key)
        math(EXPR at "${at} + 1")
        string(SUBSTRING "${pair}" ${at} -1 value)
        __cardenza_web_json_string(value "${value}")
        string(JSON json SET "${json}" "${key}" "${value}")
    endforeach()
    set(list "[]")
    set(index 0)
    foreach(component IN LISTS names)
        __cardenza_web_json_string(value "${component}")
        string(JSON list SET "${list}" ${index} "${value}")
        math(EXPR index "${index} + 1")
    endforeach()
    string(JSON json SET "${json}" components "${list}")
    file(WRITE "${CMAKE_BINARY_DIR}/cardenza_web_project.json" "${json}\n")
endfunction()
