# Builds: the device (idf.py) and the browser (cardenza_web.py)
build/
build-*/
# Generated from sdkconfig.defaults by idf.py; commit the defaults, not this
sdkconfig
sdkconfig.old
# Downloaded by the component manager (dependencies.lock pins them: commit the lock)
managed_components/
# Secrets never go into the repository (203c refuses a source archive that has them)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
